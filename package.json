{
  "name": "matchday",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "data:names": "node scripts/extract-names.mjs",
    "data:players": "node scripts/fetch-players.mjs",
